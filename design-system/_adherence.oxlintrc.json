{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "assets/**",
              "assets/artefatti/**",
              "assets/artefatti/giochi/**",
              "assets/artefatti/lezione/**",
              "assets/mascotte/**",
              "components/brand/**",
              "components/core/**",
              "components/exam/**",
              "ui_kits/giochi/**",
              "ui_kits/lezione/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Cinzel|Cormorant Garamond|Figtree))/i]",
        "message": "Font not provided by the design system. Available: Cinzel, Cormorant Garamond, Figtree."
      },
      {
        "selector": "JSXOpeningElement[name.name='Amdg'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|key|ref|className|style|children)$/]",
        "message": "<Amdg> doesn't accept that prop. Declared props: size."
      },
      {
        "selector": "JSXOpeningElement[name.name='AmdgEgg'] > JSXAttribute > JSXIdentifier[name!=/^(?:secret|clicks|duration|key|ref|className|style|children)$/]",
        "message": "<AmdgEgg> doesn't accept that prop. Declared props: secret, clicks, duration."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, variant."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:viola|ciano|ambra|rosa|verde|rosso)$/]",
        "message": "<Badge> variant must be one of 'viola' | 'ciano' | 'ambra' | 'rosa' | 'verde' | 'rosso'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|href|onClick|disabled|type|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, href, onClick, disabled, type."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|ghost|gold|solemn)$/]",
        "message": "<Button> variant must be one of 'primary' | 'ghost' | 'gold' | 'solemn'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Button> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|onClick|tilt|glow|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, style, onClick, tilt, glow."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|active|onClick|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: children, active, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='ExamBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|key|ref|className|style|children)$/]",
        "message": "<ExamBadge> doesn't accept that prop. Declared props: status."
      },
      {
        "selector": "JSXOpeningElement[name.name='ExamBadge'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:bozza|pubblicata|chiusa|corretta|consegnata|in_corso)$/]",
        "message": "<ExamBadge> status must be one of 'bozza' | 'pubblicata' | 'chiusa' | 'corretta' | 'consegnata' | 'in_corso'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|type|placeholder|value|onChange|hint|multiline|rows|id|required|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, type, placeholder, value, onChange, hint, multiline, rows, id, required."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:text|email|password|number|search)$/]",
        "message": "<Input> type must be one of 'text' | 'email' | 'password' | 'number' | 'search'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Nota'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|icon|key|ref|className|style|children)$/]",
        "message": "<Nota> doesn't accept that prop. Declared props: children, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='YearCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:year|name|description|count|href|onClick|mascot|key|ref|className|style|children)$/]",
        "message": "<YearCard> doesn't accept that prop. Declared props: year, name, description, count, href, onClick, mascot."
      },
      {
        "selector": "JSXOpeningElement[name.name='YearMascot'] > JSXAttribute > JSXIdentifier[name!=/^(?:year|size|speak|halo|still|key|ref|className|style|children)$/]",
        "message": "<YearMascot> doesn't accept that prop. Declared props: year, size, speak, halo, still."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
